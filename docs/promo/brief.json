{
  "version": 1,
  "name": "iphone-use-promo",
  "style": "promo",
  "languages": [
    "zh",
    "en"
  ],
  "formats": [
    "landscape",
    "vertical"
  ],
  "fps": 30,
  "theme": {
    "accent": "#0a84ff"
  },
  "music": "builtin",
  "sfx": true,
  "scenes": [
    {
      "id": "hook",
      "type": "title",
      "title": {
        "zh": "让 AI 用你的\n真 iPhone",
        "en": "Let AI use\nyour real iPhone"
      },
      "subtitle": {
        "zh": "iphone-use · 没有 API 的 App 也能操作",
        "en": "iphone-use · even apps with no API"
      }
    },
    {
      "id": "how",
      "type": "diagram",
      "title": {
        "zh": "怎么连起来的",
        "en": "How it fits together"
      },
      "nodes": [
        {
          "id": "agent",
          "label": {
            "zh": "AI agent",
            "en": "AI agent"
          },
          "note": "Claude Code · MCP"
        },
        {
          "id": "mac",
          "label": "iphone-use",
          "note": {
            "zh": "Mac 上的守护进程",
            "en": "daemon on your Mac"
          }
        },
        {
          "id": "phone",
          "label": "iPhone",
          "note": {
            "zh": "USB · WebDriverAgent",
            "en": "USB · WebDriverAgent"
          }
        }
      ],
      "edges": [
        {
          "from": "agent",
          "to": "mac",
          "label": {
            "zh": "/agent/* 接口",
            "en": "/agent/* API"
          }
        },
        {
          "from": "mac",
          "to": "phone",
          "label": {
            "zh": "点、滑、输入",
            "en": "tap · swipe · type"
          }
        }
      ]
    },
    {
      "id": "features",
      "type": "features",
      "title": {
        "zh": "这一版能做什么",
        "en": "What it does now"
      },
      "items": [
        {
          "zh": "界面读成文字，按编号点击",
          "en": "Screen as text, tap by element"
        },
        {
          "zh": "点了没生效会直接说",
          "en": "Says so when an action did not land"
        },
        {
          "zh": "禁止截屏的 App 也能看",
          "en": "Sees screens apps hide from capture"
        },
        {
          "zh": "锁屏几秒提示，解锁即连",
          "en": "Locked? Told in seconds, then connects"
        },
        {
          "zh": "浏览器或 iPhone App 远程操作",
          "en": "Drive it from a browser or the iOS app"
        },
        {
          "zh": "21 个 MCP 工具",
          "en": "21 MCP tools"
        }
      ]
    },
    {
      "id": "browser",
      "type": "image",
      "title": {
        "zh": "远程控制",
        "en": "Remote control"
      },
      "image": "images/hero.png",
      "caption": {
        "zh": "在浏览器或 iPhone App 里看实时画面，点击、滑动、输入都发到手机",
        "en": "A live screen in the browser or the iPhone app; taps, swipes and typing go to the phone"
      }
    },
    {
      "id": "wireframe",
      "type": "image",
      "title": {
        "zh": "截图被屏蔽？画控件树",
        "en": "Capture blocked? Draw the tree"
      },
      "image": "images/wireframe.png",
      "caption": {
        "zh": "支付类 App 截屏是一片白，iphone-use 按控件树画出按钮和文字",
        "en": "Payment apps blank every capture; iphone-use draws their buttons and text from the accessibility tree"
      }
    },
    {
      "id": "api",
      "type": "terminal",
      "title": {
        "zh": "agent 的一步：读、点、看结果",
        "en": "One agent step: read, tap, observe"
      },
      "panes": [
        {
          "label": "Terminal"
        }
      ],
      "lines": [
        {
          "cmd": "curl $HOST/agent/elements"
        },
        {
          "out": "{\"snapshot\":\"…\",\"elements\":[… {\"kind\":\"Button\",\"label\":\"通用\"} …]}",
          "tone": "dim"
        },
        {
          "cmd": "curl -X POST $HOST/agent/input?return=delta -d '{\"type\":\"tap\",\"element\":7,\"snapshot\":\"…\"}'"
        },
        {
          "out": "{\"ok\":true,\"settle\":{\"reason\":\"stable\",\"captures\":1},\"delta\":{…}}",
          "tone": "ok"
        },
        {
          "out": {
            "zh": "点击 + 等画面稳定：约 4 秒（上一版 8.5 秒）",
            "en": "Tap + settled screen: ~4 s (was 8.5 s)"
          },
          "tone": "dim"
        }
      ]
    },
    {
      "id": "perf",
      "type": "steps",
      "title": {
        "zh": "为什么快",
        "en": "Why it is fast"
      },
      "steps": [
        {
          "title": {
            "zh": "只读一次",
            "en": "Read the screen once"
          },
          "body": {
            "zh": "点击复用刚读的树，只核对目标位置",
            "en": "taps reuse the tree just read; only the target is re-checked"
          }
        },
        {
          "title": {
            "zh": "截图判稳",
            "en": "Settle on frames"
          },
          "body": {
            "zh": "读树前后两帧相同，就不读第二遍",
            "en": "same frame before and after the read: no second read"
          }
        },
        {
          "title": {
            "zh": "不重复问",
            "en": "No repeat questions"
          },
          "body": {
            "zh": "屏幕尺寸、弹窗检查都有缓存",
            "en": "screen size and alert checks are cached"
          }
        },
        {
          "title": {
            "zh": "每步有账",
            "en": "Every step is timed"
          },
          "body": {
            "zh": "每个请求都带耗时拆分",
            "en": "every answer carries its timing"
          }
        }
      ]
    },
    {
      "id": "perf-numbers",
      "type": "title",
      "title": {
        "zh": "8.5 秒 → 4.2 秒",
        "en": "8.5 s → 4.2 s"
      },
      "subtitle": {
        "zh": "点击并等画面稳定 · 冷启动 75 秒 → 13 秒",
        "en": "tap and settle · cold connect 75 s → 13 s"
      }
    },
    {
      "id": "tokens",
      "type": "features",
      "title": {
        "zh": "也省 token",
        "en": "And fewer tokens"
      },
      "items": [
        {
          "zh": "屏幕读成文字，不用每步看截图",
          "en": "Screen as text, not a screenshot"
        },
        {
          "zh": "?since 只返回变了的部分",
          "en": "?since returns only what changed"
        },
        {
          "zh": "点完直接带回变化，省一次读取",
          "en": "Taps return the change: no extra read"
        },
        {
          "zh": "最多 24 步一次发出",
          "en": "Up to 24 steps in one call"
        },
        {
          "zh": "flow 重放不经过模型，零 token",
          "en": "Flows replay with no model: 0 tokens"
        }
      ]
    },
    {
      "id": "flows-loop",
      "type": "steps",
      "title": {
        "zh": "做过一次，就沉淀成脚本",
        "en": "Do it once, keep it as a flow"
      },
      "steps": [
        {
          "title": {
            "zh": "录制",
            "en": "Record"
          },
          "body": {
            "zh": "浏览器里操作一遍就录好",
            "en": "drive it once in the browser"
          }
        },
        {
          "title": {
            "zh": "发布",
            "en": "Publish"
          },
          "body": {
            "zh": "审阅后进官方 flow 源",
            "en": "reviewed into the official registry"
          }
        },
        {
          "title": {
            "zh": "重放",
            "en": "Replay"
          },
          "body": {
            "zh": "一条命令，不经过模型",
            "en": "one command, no model"
          }
        },
        {
          "title": {
            "zh": "反馈",
            "en": "Report"
          },
          "body": {
            "zh": "App 改版坏了一键报告",
            "en": "one command when an app update breaks it"
          }
        }
      ]
    },
    {
      "id": "flows",
      "type": "terminal",
      "title": {
        "zh": "一条命令导出健康数据",
        "en": "Export Health data in one command"
      },
      "panes": [
        {
          "label": "Terminal"
        }
      ],
      "lines": [
        {
          "cmd": "iphone-use-mcp flow update"
        },
        {
          "out": {
            "zh": "同步官方 flow 源，逐个校验 sha256",
            "en": "mirror the official registry, sha256-checked"
          },
          "tone": "dim"
        },
        {
          "cmd": "iphone-use-mcp flow run health/export-all-zh-cn"
        },
        {
          "out": {
            "zh": "按步骤执行，不调用模型",
            "en": "runs step by step, no model in the loop"
          },
          "tone": "ok"
        },
        {
          "out": {
            "zh": "失败时给出诊断：哪一步、为什么",
            "en": "on failure: which step, and why"
          },
          "tone": "dim"
        }
      ]
    },
    {
      "id": "start",
      "type": "steps",
      "title": {
        "zh": "三步上手",
        "en": "Three steps"
      },
      "steps": [
        {
          "title": {
            "zh": "装到 Mac 上",
            "en": "Install on the Mac"
          },
          "body": {
            "zh": "一行命令",
            "en": "one command"
          }
        },
        {
          "title": {
            "zh": "用 USB 接上 iPhone",
            "en": "Plug in the iPhone"
          },
          "body": {
            "zh": "自动装好 WDA",
            "en": "WDA is set up for you"
          }
        },
        {
          "title": {
            "zh": "让 agent 开工",
            "en": "Let the agent work"
          },
          "body": {
            "zh": "MCP 或 HTTP",
            "en": "MCP or HTTP"
          }
        }
      ]
    },
    {
      "id": "outro",
      "type": "cta",
      "title": "iphone-use",
      "subtitle": {
        "zh": "开源 · 让 AI 操作真 iPhone",
        "en": "Open source · AI on a real iPhone"
      },
      "command": "curl -fsSL https://raw.githubusercontent.com/leeguooooo/iphone-use/main/install.sh | sh",
      "url": "github.com/leeguooooo/iphone-use"
    }
  ],
  "voiceover": {
    "dir": "voiceover"
  }
}
